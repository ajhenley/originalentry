# Copy to .env and fill in. Config variables per T13.
APP_ENV=development
SECRET_KEY=change-me

# Neon (T12): pooled endpoint for the app, direct endpoint for migrations/import/purge/backups.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@POOLED-HOST/DBNAME?sslmode=require
DATABASE_URL_DIRECT=postgresql+psycopg://USER:PASSWORD@DIRECT-HOST/DBNAME?sslmode=require

EMAIL_BACKEND=console
MAIL_FROM=sign-in@your-subdomain.example.edu
MAIL_REPLY_TO=instructor@example.edu
RESEND_API_KEY=

# Production is https://originalentry.com; sign-in links are built from this, so it must
# match the host people actually reach.
APP_BASE_URL=http://localhost:5000
COURSE_TZ=America/Los_Angeles
